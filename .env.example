# Copy this file to .env and fill in your key. .env is ignored by Git.

# Required: your Anthropic API key (https://platform.claude.com/)
ANTHROPIC_API_KEY=

# Optional: model used for enhancement (default: claude-opus-5-5).
# claude-haiku-5-5 is a cheaper, faster choice for this kind of rewriting.
# ENHANCER_MODEL=claude-opus-5-5

# Optional: set to "off" to disable the server-side refusal fallback.
# ENHANCER_FALLBACKS=off

# Optional: address the web app listens on (default: 127.0.0.1:3000).
# HOST=127.0.0.1
# PORT=3000
